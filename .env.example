OPENAI_API_KEY=你的openai_api金鑰
# OpenAI Agent 預設採低成本路由、較強整理與旗艦錯誤備援；可依帳號權限覆寫。
# OPENAI_ROUTING_MODEL=gpt-5.4-nano
# OPENAI_SYNTHESIS_MODEL=gpt-5.4-mini
# OPENAI_FALLBACK_MODEL=gpt-5.4
# 此 read token 所屬帳號必須已同意 TAIDE 基礎模型條款並取得 gated 存取權。
HF_TOKEN=你的huggingface_read_token

# LangSmith 為選用的開發／評估服務。日常執行預設不傳送 trace；啟用前請確認
# 輸入不含委任案件或其他非公開個資。評估腳本只使用 evals/ 內的合成案例。
# LANGSMITH_API_KEY=你的langsmith_api金鑰
# LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=legal-rag-agent

# 以下皆有程式預設值；只有切換模型版本或裝置時才需要取消註解覆寫。
# PUBLIC_INSULT_BASE_MODEL_ID=taide/Llama-3.1-TAIDE-LX-8B-Chat
# PUBLIC_INSULT_BASE_MODEL_REVISION=6738923786667dfe00363b1e2d225536817b429e
# PUBLIC_INSULT_ADAPTER_A_ID=a97141481/Llama-3.1-TAIDE-Public-Insult-A-LoRA
# PUBLIC_INSULT_ADAPTER_A_REVISION=v1.0
# PUBLIC_INSULT_ADAPTER_B_ID=a97141481/Llama-3.1-TAIDE-Public-Insult-B-LoRA
# PUBLIC_INSULT_ADAPTER_B_REVISION=v1.0
# PUBLIC_INSULT_ADAPTER_C_ID=a97141481/Llama-3.1-TAIDE-Public-Insult-C-LoRA
# PUBLIC_INSULT_ADAPTER_C_REVISION=v1.0
# PUBLIC_INSULT_DEVICE=auto
# PUBLIC_INSULT_MAX_INPUT_TOKENS=1024
# PUBLIC_INSULT_MAX_NEW_TOKENS=512

# RAG 預設使用 CPU，避免 BGE embedding、reranker 與 TAIDE 8B 同時占用 MPS。
# RAG_DEVICE=cpu
